# Copy this file to .env and fill in your values. .env is gitignored.

# Google Gemini API key — create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the default image model (gemini-nano-banana-2.1) for the CLI tools.
# The web app uses the model picked in Settings.
# BIRDSCREEN_IMAGE_MODEL=gemini-3-pro-image

# Optional: override the text model for the season description (gemini-3.8-flash).
# BIRDSCREEN_TEXT_MODEL=gemini-3.5-flash-lite
